<?xml version="1.0" encoding="utf-8"?>
<!--
  RELAX NG schema for Mixxx MIDI controller mappings (schemaVersion 1).

  Generated by AI.

  Run it with: xmllint (noout) (relaxng mixxx-mapping.rng) *.midi.xml
  See .github/workflows/check-xmllint.yaml for the exact command; XML comments
  cannot contain a double hyphen, so the flags are written in parentheses here.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <element name="MixxxControllerPreset">
      <attribute name="mixxxVersion"/>
      <attribute name="schemaVersion">
        <data type="positiveInteger"/>
      </attribute>
      <optional>
        <ref name="info"/>
      </optional>
      <oneOrMore>
        <ref name="controller"/>
      </oneOrMore>
    </element>
  </start>

  <define name="info">
    <element name="info">
      <interleave>
        <optional><element name="name"><text/></element></optional>
        <optional><element name="author"><text/></element></optional>
        <optional><element name="description"><text/></element></optional>
        <optional><element name="wiki"><data type="anyURI"/></element></optional>
        <optional><element name="forums"><data type="anyURI"/></element></optional>
        <optional><element name="manual"><text/></element></optional>
      </interleave>
    </element>
  </define>

  <define name="controller">
    <element name="controller">
      <attribute name="id"/>
      <interleave>
        <optional><ref name="scriptfiles"/></optional>
        <optional><ref name="controls"/></optional>
        <optional><ref name="outputs"/></optional>
      </interleave>
    </element>
  </define>

  <define name="scriptfiles">
    <element name="scriptfiles">
      <zeroOrMore>
        <element name="file">
          <attribute name="filename"/>
          <optional>
            <attribute name="functionprefix"/>
          </optional>
        </element>
      </zeroOrMore>
    </element>
  </define>

  <define name="controls">
    <element name="controls">
      <zeroOrMore>
        <element name="control">
          <interleave>
            <ref name="group"/>
            <ref name="key"/>
            <optional><ref name="description"/></optional>
            <ref name="status"/>
            <optional><ref name="midino"/></optional>
            <optional><ref name="options"/></optional>
          </interleave>
        </element>
      </zeroOrMore>
    </element>
  </define>

  <define name="outputs">
    <element name="outputs">
      <zeroOrMore>
        <element name="output">
          <interleave>
            <ref name="group"/>
            <ref name="key"/>
            <optional><ref name="description"/></optional>
            <ref name="status"/>
            <ref name="midino"/>
            <optional><element name="on"><ref name="midiByte"/></element></optional>
            <optional><element name="off"><ref name="midiByte"/></element></optional>
            <element name="minimum"><ref name="controlValue"/></element>
            <optional><element name="maximum"><ref name="controlValue"/></element></optional>
          </interleave>
        </element>
      </zeroOrMore>
    </element>
  </define>

  <define name="group">
    <element name="group">
      <data type="token">
        <param name="pattern">\[[A-Za-z0-9_]+\]</param>
      </data>
    </element>
  </define>

  <define name="key">
    <element name="key">
      <data type="token">
        <param name="pattern">[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)?</param>
      </data>
    </element>
  </define>

  <define name="description">
    <element name="description"><text/></element>
  </define>

  <define name="status">
    <element name="status"><ref name="midiByte"/></element>
  </define>

  <define name="midino">
    <element name="midino"><ref name="midiByte"/></element>
  </define>

  <define name="midiByte">
    <data type="token">
      <param name="pattern">0[xX][0-9a-fA-F]{1,2}|[0-9]{1,3}</param>
    </data>
  </define>

  <define name="controlValue">
    <data type="decimal"/>
  </define>

  <define name="options">
    <element name="options">
      <zeroOrMore>
        <choice>
          <element name="normal"><empty/></element>
          <element name="invert"><empty/></element>
          <element name="rot64"><empty/></element>
          <element name="rot64inv"><empty/></element>
          <element name="rot64fast"><empty/></element>
          <element name="diff"><empty/></element>
          <element name="button"><empty/></element>
          <element name="switch"><empty/></element>
          <element name="hercjog"><empty/></element>
          <element name="hercjogfast"><empty/></element>
          <element name="spread64"><empty/></element>
          <element name="selectknob"><empty/></element>
          <element name="soft-takeover"><empty/></element>
          <element name="script-binding"><empty/></element>
          <element name="fourteen-bit-msb"><empty/></element>
          <element name="fourteen-bit-lsb"><empty/></element>
        </choice>
      </zeroOrMore>
    </element>
  </define>

</grammar>
