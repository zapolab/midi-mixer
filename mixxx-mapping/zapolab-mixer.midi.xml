<?xml version="1.0" encoding="utf-8" ?>
<MixxxControllerPreset mixxxVersion="2.5.0" schemaVersion="1">
  <info>
    <name>zapolab mixer</name>
    <author>zapolab</author>
    <description
    >Mapping for the zapolab RP2040 MIDI mixer: two volume faders, a master gain, two play/pause buttons with LED feedback, a load button per deck, a library scroll encoder and a shift button. Everything sits on MIDI channel 1.</description>
    <wiki>https://github.com/zapolab/midi-mixer</wiki>
  </info>
  <!-- id must match config.product in the firmware -->
  <controller id="RP2040 Mixer">
    <controls>
      <!--
        Shift adds 0x10 to the midino, so unshifted controls
        are in 0x00-0x0F and its shifted twin in 0x10-0x1F:

        CC   0x00-0x07  pots       0x10-0x17  shifted
        CC   0x08-0x0F  encoders   0x18-0x1F  shifted
        Note 0x00-0x0F  buttons    0x10-0x1F  shifted
        Note 0x20-0x2F  feedback from Mixxx, see (outputs)
      -->
      <!-- Pots -->
      <control>
        <group>[Channel1]</group>
        <key>volume</key>
        <description>Deck 1 volume fader</description>
        <status>0xB0</status>
        <midino>0x00</midino>
        <options>
          <normal />
        </options>
      </control>
      <control>
        <group>[Channel2]</group>
        <key>volume</key>
        <description>Deck 2 volume fader</description>
        <status>0xB0</status>
        <midino>0x01</midino>
        <options>
          <normal />
        </options>
      </control>
      <control>
        <group>[Master]</group>
        <key>gain</key>
        <description>Master output gain</description>
        <status>0xB0</status>
        <midino>0x02</midino>
        <options>
          <normal />
        </options>
      </control>
      <!-- Encoders: 0x01 UP, 0x7F DOWN -->
      <control>
        <group>[Library]</group>
        <key>MoveVertical</key>
        <description>Scroll through the library</description>
        <status>0xB0</status>
        <midino>0x08</midino>
        <options>
          <selectknob />
        </options>
      </control>
      <!-- Buttons -->
      <control>
        <group>[Channel1]</group>
        <key>play</key>
        <description>Deck 1 play/pause</description>
        <status>0x90</status>
        <midino>0x00</midino>
        <options>
          <normal />
        </options>
      </control>
      <control>
        <group>[Channel2]</group>
        <key>play</key>
        <description>Deck 2 play/pause</description>
        <status>0x90</status>
        <midino>0x01</midino>
        <options>
          <normal />
        </options>
      </control>
      <!-- Load: the firmware picks the note from the deck switch -->
      <control>
        <group>[Channel1]</group>
        <key>LoadSelectedTrack</key>
        <description>Load selected track into deck 1</description>
        <status>0x90</status>
        <midino>0x02</midino>
        <options>
          <normal />
        </options>
      </control>
      <control>
        <group>[Channel2]</group>
        <key>LoadSelectedTrack</key>
        <description>Load selected track into deck 2</description>
        <status>0x90</status>
        <midino>0x03</midino>
        <options>
          <normal />
        </options>
      </control>
      <!-- Shifted buttons -->
      <control>
        <group>[Channel1]</group>
        <key>cue_gotoandstop</key>
        <description>Shift + deck 1 play: cue and stop</description>
        <status>0x90</status>
        <midino>0x10</midino>
        <options>
          <normal />
        </options>
      </control>
      <control>
        <group>[Channel2]</group>
        <key>cue_gotoandstop</key>
        <description>Shift + deck 2 play: cue and stop</description>
        <status>0x90</status>
        <midino>0x11</midino>
        <options>
          <normal />
        </options>
      </control>
    </controls>
    <outputs>
      <!-- Feedback from Mixxx -->
      <output>
        <group>[Channel1]</group>
        <key>play_indicator</key>
        <description>Deck 1 play LED</description>
        <status>0x90</status>
        <midino>0x20</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
        <maximum>1.0</maximum>
      </output>
      <output>
        <group>[Channel2]</group>
        <key>play_indicator</key>
        <description>Deck 2 play LED</description>
        <status>0x90</status>
        <midino>0x21</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
        <maximum>1.0</maximum>
      </output>
      <output>
        <group>[Channel1]</group>
        <key>play</key>
        <description>Deck 1 play state</description>
        <status>0x90</status>
        <midino>0x22</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
        <maximum>1.0</maximum>
      </output>
      <output>
        <group>[Channel2]</group>
        <key>play</key>
        <description>Deck 2 play state</description>
        <status>0x90</status>
        <midino>0x23</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
        <maximum>1.0</maximum>
      </output>
    </outputs>
  </controller>
</MixxxControllerPreset>
